# Copy to .env (gitignored) and fill in. Used only by scripts/luno-snapshot.ts, run locally by you —
# never committed, never sent to Netlify. The script loads it automatically.

# Luno API key with ONLY the "Perm_R_Balance" (read balance) permission.
# Create one at https://www.luno.com/wallet/security/api_keys
LUNO_API_KEY_ID=your-key-id
LUNO_API_KEY_SECRET=your-key-secret
