# Telegram (recommended): create a bot with @BotFather, then message it once
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy.sh (optional alternative/extra): pick a long random topic name, subscribe in the ntfy app
NTFY_TOPIC=

# Set to 1 to also receive lower-confidence SMEE news (entity match without a listing keyword)
ALERT_ALL=

# Profit-banking positions (private cost basis). JSON array; in GitHub, set it as the POSITIONS_JSON secret.
# POSITIONS_JSON=[{"symbol":"ANG.JO","label":"AngloGold Ashanti","track":"core","costPerUnit":1879.7}]

# Optional
LOG_LEVEL=info